# ── LiveKit Server ──
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ── RAG Backend ──
TEXT_BACKEND_URL=http://localhost:8000

# ── Speech-to-Text ──
STT_PROVIDER=deepgram          # deepgram | local_whisper
DEEPGRAM_API_KEY=              # required for deepgram
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi        # "multi" = auto language detection

# Local Whisper (if STT_PROVIDER=local_whisper)
# WHISPER_MODEL=large-v3
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE_TYPE=float16

# ── Text-to-Speech ──
TTS_PROVIDER=cartesia          # cartesia | elevenlabs | piper
CARTESIA_API_KEY=              # required for cartesia
CARTESIA_MODEL=sonic-3

# ElevenLabs (if TTS_PROVIDER=elevenlabs)
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_turbo_v2_5

# Piper local (if TTS_PROVIDER=piper)
# PIPER_MODEL_PATH=
# PIPER_CONFIG_PATH=

# ── LLM ──
LLM_MODEL=gpt-4o-mini
LLM_API_BASE=                  # empty = OpenAI default; set for LiteLLM proxy
LLM_API_KEY=                   # empty = uses OPENAI_API_KEY
OPENAI_API_KEY=

# ── RAG Backend API (for backend_api.py) ──
RAG_LLM_PROVIDER=openai
RAG_LLM_MODEL=
RAG_EMBEDDING_PROVIDER=openai
RAG_COLLECTION=trca_documents
RAG_TOP_K=22
RAG_CHUNK_SIZE=700
RAG_PDF_DIR=data
